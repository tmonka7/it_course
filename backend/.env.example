PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/sist
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173

# Optional: serve the API over HTTPS (browsers only allow camera/microphone on HTTPS or localhost)
# SSL_KEY_FILE=../server.key
# SSL_CERT_FILE=../server.crt

# Optional: MediaMTX gateway for live camera view (see docker-compose.yml)
# MEDIAMTX_API_URL=http://127.0.0.1:9997
# MEDIAMTX_HLS_URL=http://127.0.0.1:8888

# Optional: WebRTC ICE servers for meetings (JSON). Add TURN for users behind strict firewalls.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]

# Hour (0-23) after which open commands without today's progress log trigger a reminder; -1 disables
COMMAND_REMINDER_HOUR=17
